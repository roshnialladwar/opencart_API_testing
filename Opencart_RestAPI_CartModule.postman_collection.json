  "item": [
    {
      "name": "create a token/session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status code is 200\",() =>{\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "//capturing response\r",
              "var jsondata=pm.response.json();\r",
              "\r",
              "//validating json response\r",
              "pm.test(\"success message is displayed\",()=>{\r",
              "    pm.expect(jsondata.success).to.eql(\"Success: API session successfully started!\");\r",
              "});\r",
              "\r",
              "//storing token in variable\r",
              "pm.collectionVariables.set(\"api_token_val\",jsondata.api_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "value",
              "value": "{{api_token_val}}",
              "type": "string"
            },
            {
              "key": "in",
              "value": "query",
              "type": "string"
            },
            {
              "key": "key",
              "value": "api_token",
              "type": "string"
            }
          ]
        },
        "method": "POST",
